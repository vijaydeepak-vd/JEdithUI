# ─── Ollama Configuration ───────────────────────────
# Cloud-hosted Ollama endpoint (or local: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# API key for cloud Ollama (leave empty for local)
OLLAMA_API_KEY=""

# Default model (cloud: gemma4:31b-cloud, local: gemma4:latest)
OLLAMA_DEFAULT_MODEL="gemma4:latest"

# Available cloud models (format: name|cap1|cap2, name|cap1|cap2)
# Capabilities: vision, thinking, tools, code
# Size (e.g. 31B) is auto-extracted from the model name
OLLAMA_MODEL_LIST="gemma4:latest|vision|thinking|tools"

# ─── Upstash Redis (Vercel Storage) ───────────────
# Required for IP-based daily prompt quotas
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
