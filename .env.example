# ─── Ollama Configuration ───────────────────────────
# Cloud-hosted Ollama endpoint (or local: http://localhost:11434)
OLLAMA_BASE_URL="https://your-ollama-cloud-endpoint.com"

# API key for cloud Ollama (leave empty for local)
OLLAMA_API_KEY=""

# Default model (cloud: gemma4:31b-cloud, local: gemma4:12b)
OLLAMA_DEFAULT_MODEL="gemma4:31b-cloud"
